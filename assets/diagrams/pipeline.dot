digraph SpeedQ {
 graph [rankdir=LR,bgcolor="white",pad="0.3",nodesep="0.28",ranksep="0.28",fontname="DejaVu Sans",fontsize=19,label="SpeedQ · escalated case workflow\nCompleted hackathon prototype | Submitted 17 November 2026",labelloc=t];
 node [shape=box,style="rounded,filled",fillcolor="#F7F7F6",color="#DEDAD7",fontname="DejaVu Sans",fontsize=12,margin="0.15,0.14",fontcolor="#1F2029"];
 edge [color="#705D59",arrowsize=0.7];
 customer [label="Customer\nDescribes the need"];
 intake [label="Clario intake\nHosted Retell voice/chat\nor local scripted demo"];
 card [label="Service card\nDraft → customer\nconfirmation"];
 engine [label="Prorio\nEvidence + rule-based\npriority and protocol",fillcolor="#FCEDEA",color="#B5120C"];
 officer [label="Ranked queue\nOfficer claims, reviews\nand approves / modifies",fillcolor="#FCEDEA",color="#B5120C"];
 outcome [label="Recorded outcome\nSimulated actions\nCustomer status + audit"];
 customer -> intake -> card -> engine -> officer -> outcome;
}
